#include <stdio.h>

int main() {
    
    int a, b;
    printf("Podaj dwie liczby calkowite: \n");
    scanf("%d, %d \n", &a, &b);


if (a<b){
    printf("Wieksza liczba to %d, a mniejsza to %d, relacja: %d < %d", b, a, a, b);
}

else if (a>b){
    printf("Wieksza liczba to %d, a mniejsza to %d, relacja: %d > %d", a, b, a, b);
}

else{
    printf("Obie liczby sa rowne, relacja: %d = %d", a, b);
}

return 0;   

}
